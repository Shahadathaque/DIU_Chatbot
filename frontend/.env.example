# Frontend environment (copy to .env.local)
# NEXT_PUBLIC_* values are embedded during `next build` and are safe only for
# non-secret, browser-visible configuration.

# Local development: true keeps the frontend self-contained with mock fixtures.
# Set false when running the FastAPI service locally.
NEXT_PUBLIC_USE_MOCK_API=true

# Local backend base URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel production values (set these in Project Settings → Environment
# Variables; do not commit a production URL here):
# NEXT_PUBLIC_USE_MOCK_API=false
# NEXT_PUBLIC_API_URL=https://your-backend.example.com
