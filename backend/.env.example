# ============================================
# Environment Configuration
# ============================================
APP_ENV=development
# Production: APP_ENV=production
LOG_LEVEL=INFO

# ============================================
# Database (Required in Production)
# ============================================
# Development: use local SQLite or leave empty
# DATABASE_URL=postgresql://user:password@localhost:5432/diu_admission
DATABASE_URL=
RUNTIME_CATALOG_BACKEND=local
RAG_VECTOR_BACKEND=pgvector

# ============================================
# External LLM Model (Qwen or other OpenAI-compatible provider)
# Required in production. Keep local only for development.
# ============================================
GENERATOR_BACKEND=local
GENERATOR_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
GENERATOR_MAX_NEW_TOKENS=384
GENERATOR_TEMPERATURE=0.0
GENERATOR_TOP_P=0.9
# Production example:
# GENERATOR_BACKEND=openai
# GENERATOR_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# GENERATOR_API_MODEL=gemini-2.5-flash
GENERATOR_API_BASE=
GENERATOR_API_KEY=
GENERATOR_API_MODEL=
# Gemini 3 chat example: minimal reduces latency and hidden reasoning token use.
GENERATOR_API_REASONING_EFFORT=

# ============================================
# RAG and Embeddings
# ============================================
MODEL_NAME=qwen/qwen-2.5-1.5b-instruct
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
# Gemini example: gemini-embedding-2 (768 dimensions recommended).
EMBEDDING_API_MODEL=
EMBEDDING_DIMENSION=768
EMBEDDING_API_TIMEOUT=30
# Optional indexing throttle for free-tier hosted providers; runtime queries are unaffected.
EMBEDDING_API_REQUEST_INTERVAL=0
EMBEDDING_API_SEND_DIMENSIONS=true
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Hugging Face token (required only for gated models)
HF_TOKEN=

# Connection pool (Neon/managed PostgreSQL)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=10

# Reliability and monitoring
RATE_LIMIT_PER_MINUTE=30
SENTRY_DSN=

# ============================================
# CORS Configuration
# Comma-separated list of allowed browser origins
# Do not use '*' in production; include each Vercel/custom domain explicitly.
# ============================================
CORS_ORIGINS=http://localhost:3000
# Production example:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-domain.com
