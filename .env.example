# Copy this file to .env and provide local values. Never commit secrets.
DATABASE_URL=
RUNTIME_CATALOG_BACKEND=local
MODEL_NAME=
# Multilingual E5 supports English, Bangla, and code-mixed Banglish queries.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_MODEL_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=
# Production: use the same hosted model for document indexing and queries.
# Rebuild into a new RAG_TABLE_NAME when changing embedding model/backend.
EMBEDDING_BACKEND=local
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
# Gemini example: gemini-embedding-2 (768 dimensions recommended).
EMBEDDING_API_MODEL=
EMBEDDING_API_TIMEOUT=30
# Optional indexing throttle for free-tier hosted providers; runtime queries are unaffected.
EMBEDDING_API_REQUEST_INTERVAL=0
EMBEDDING_API_MAX_RETRIES=2
EMBEDDING_API_RETRY_BACKOFF=0.5
EMBEDDING_API_SEND_DIMENSIONS=true

# Production uses pgvector. Set "local" only for development/testing.
RAG_VECTOR_BACKEND=pgvector
RAG_TABLE_NAME=diu_knowledge_chunks
RAG_LOCAL_STORE_PATH=data/chunks/local_knowledge_base.json
RAG_CLEANED_DATA_PATH=data/cleaned/v2
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_MIN_CHUNK_SIZE=100
RAG_MIN_SIMILARITY_SCORE=0.75
RAG_MIN_RELEVANCE_SCORE=0.72
RAG_CANDIDATE_MULTIPLIER=5
RAG_MAX_RESULTS_PER_SOURCE=5
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=10
HF_TOKEN=
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# LLM generation (TASK-02). Local Qwen on Apple MPS is the default.
GENERATOR_BACKEND=local
GENERATOR_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
GENERATOR_MODEL_REVISION=
GENERATOR_DEVICE=mps
GENERATOR_MAX_NEW_TOKENS=384
GENERATOR_TEMPERATURE=0.0
GENERATOR_TOP_P=0.9

# OpenAI-compatible backend (only needed when GENERATOR_BACKEND=openai).
GENERATOR_API_BASE=
GENERATOR_API_KEY=
GENERATOR_API_MODEL=
# Gemini 3 chat example: minimal reduces latency and hidden reasoning token use.
GENERATOR_API_REASONING_EFFORT=
GENERATOR_API_MAX_RETRIES=2
GENERATOR_API_RETRY_BACKOFF=0.5

# Optional LoRA adapter directory for future M6 fine-tuning (not implemented).
GENERATOR_LORA_ADAPTER=

# Production uses the hosted OpenAI-compatible generator above. The legacy
# OPENAI_API_BASE/OPENAI_API_KEY names are accepted only for compatibility;
# prefer GENERATOR_API_BASE/GENERATOR_API_KEY.
RATE_LIMIT_PER_MINUTE=30
SENTRY_DSN=
