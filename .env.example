# Copy this file to .env and provide local values. Never commit secrets.
DATABASE_URL=
MODEL_NAME=
# Multilingual E5 supports English, Bangla, and code-mixed Banglish queries.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_MODEL_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=

# Production uses pgvector. Set "local" only for development/testing.
RAG_VECTOR_BACKEND=pgvector
RAG_TABLE_NAME=diu_knowledge_chunks
RAG_LOCAL_STORE_PATH=data/chunks/local_knowledge_base.json
RAG_CLEANED_DATA_PATH=data/cleaned/v1
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_MIN_CHUNK_SIZE=100
RAG_MIN_SIMILARITY_SCORE=0.75
RAG_MIN_RELEVANCE_SCORE=0.72
RAG_CANDIDATE_MULTIPLIER=5
RAG_MAX_RESULTS_PER_SOURCE=5
HF_TOKEN=
APP_ENV=development
LOG_LEVEL=INFO
